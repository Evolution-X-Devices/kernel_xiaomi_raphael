# Platform
CONFIG_MACH_XIAOMI_RAPHAEL=y

# Camera motor
CONFIG_TI_DRV8846=y

# Sensors
CONFIG_AKM09970=y

# Touch
CONFIG_TOUCHSCREEN_GOODIX_GTX8=y

# TFA9874 smart amp - use the DAVI (MI2S TX hostless) path that the stock kernel ships with
CONFIG_SND_SOC_TFA9874=y
CONFIG_SND_SOC_TFA9874_FOR_DAVI=y

# Kernel name: RaphGhost. Overrides CONFIG_LOCALVERSION="-qgki_aman" from
# vendor/sm8150-qgki_defconfig; this fragment is merged after it. The kernel
# is monolithic here (no .ko anywhere, no /vendor/lib/modules), so the
# version string is cosmetic and moving it breaks nothing.
CONFIG_LOCALVERSION="-RaphGhost"
